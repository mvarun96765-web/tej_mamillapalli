# ── VARUN TEJ backend environment ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. All values below are placeholders.

# Server
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-32-bytes-minimum-random-string

# ── Angel One SmartAPI (live market data) ─────────────────────
ANGELONE_API_KEY=your-angelone-api-key
ANGELONE_CLIENT_CODE=your-client-code
ANGELONE_TOTP_SECRET=your-totp-secret
ANGELONE_PIN=your-pin


# ── News API (Marketaux - free tier ~100 req/day, max 3 articles/request) ──
# User-provided key. Collection window 08:00-14:00 IST every 3m40s (~98 req/day).
# First request of the day covers news published after the previous day 2:00 PM IST
MARKETAUX_API_KEY=your-marketaux-api-key
NEWS_API_BASE=https://api.marketaux.com/v1
NEWS_ARTICLES_PER_REQUEST=3
NEWS_WINDOW_OPEN_HOUR=8
NEWS_WINDOW_CLOSE_HOUR=14
NEWS_CATCHUP_FROM_HOUR=14
NEWS_CATCHUP_FROM_MINUTE=0
NEWS_WINDOW_OPEN_MINUTE=0
NEWS_WINDOW_CLOSE_MINUTE=0
NEWS_API_KEY=your-news-api-fallback-key-optional

# ── AI providers (defaults; keys are managed from the app Settings screen) ──
AI_WORK1_PROVIDER=google
AI_WORK1_MODEL=gemini-2.5-flash
AI_WORK2_PROVIDER=google
AI_WORK2_MODEL=gemini-2.5-flash
AI_WORK3_PROVIDER=google
AI_WORK3_MODEL=gemini-2.5-flash

# ── FCM push notifications (optional, add later) ──────────────
FCM_SERVICE_ACCOUNT_JSON=

# ── Market session (Asia/Kolkata) ─────────────────────────────
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=0
NEWS_INTERVAL_SECONDS=220

# PostgreSQL database
DATABASE_URL=postgres://user:password@127.0.0.1:5432/varuntej
